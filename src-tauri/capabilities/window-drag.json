{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-drag",
  "description": "Overlay title bar: lets the loopback mdr UI drag and zoom its own window. Nothing else.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": ["core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
}
